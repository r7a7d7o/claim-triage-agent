# Copy to .env to override local defaults. Every value below is the built-in default, so an empty
# file changes nothing; the pipeline and its compose stack run with no credentials configured.

# Environment name reported in traces and audit entries.
CLAIM_TRIAGE_ENVIRONMENT=local

# Simulated surrounding insurance systems (policy lookup, claim lookup, claim creation, status).
CLAIM_TRIAGE_CORE_SIM_BASE_URL=http://localhost:8080

# The pipeline's own two surfaces: the entry point a claim is submitted at, and the triager behind
# it. The smoke run drives the first; the first forwards to the second.
CLAIM_TRIAGE_API_BASE_URL=http://localhost:8000
CLAIM_TRIAGE_TRIAGER_BASE_URL=http://localhost:8001

# Shared infrastructure of the local compose stack.
CLAIM_TRIAGE_POSTGRES_DSN=postgresql://claim_triage:claim_triage@localhost:5432/claim_triage
CLAIM_TRIAGE_REDIS_URL=redis://localhost:6379/0
CLAIM_TRIAGE_QDRANT_URL=http://localhost:6333

# Observability. Leave unset to run with the stack down: spans are recorded and their trace
# identifiers appear in the structured logs, but nothing is exported. To see traces, bring the
# collector up and point the services at it — the endpoint is OTLP/HTTP, and a base URL works:
#
#     podman compose --profile observability up --detach --wait
#     CLAIM_TRIAGE_OTEL_ENDPOINT=http://localhost:4318   # from the host
#     CLAIM_TRIAGE_OTEL_ENDPOINT=http://otel-collector:4318   # from inside the stack
#
# CLAIM_TRIAGE_OTEL_ENDPOINT=http://localhost:4318
# CLAIM_TRIAGE_LANGFUSE_HOST=http://localhost:3000

# Host side of the compose stack's published ports, read by Compose rather than by the application.
# Only the host side moves: the stack keeps the standard ports on its own network. Uncomment one to
# move it out of the way of something already running on this machine.
# CLAIM_TRIAGE_POSTGRES_HOST_PORT=5432
# CLAIM_TRIAGE_REDIS_HOST_PORT=6379
# CLAIM_TRIAGE_QDRANT_HOST_PORT=6333
# CLAIM_TRIAGE_CORE_SIM_HOST_PORT=8080
# CLAIM_TRIAGE_API_HOST_PORT=8000
# CLAIM_TRIAGE_TRIAGER_HOST_PORT=8001
# CLAIM_TRIAGE_OTEL_HOST_PORT=4318

# Per-deployable bind address. Dashes in a deployable name become underscores in its variable.
# Ports default to the table in README.md.
# CLAIM_TRIAGE_API_HOST=127.0.0.1
# CLAIM_TRIAGE_API_PORT=8000
# CLAIM_TRIAGE_TRIAGER_HOST=127.0.0.1
# CLAIM_TRIAGE_TRIAGER_PORT=8001
# CLAIM_TRIAGE_CORE_SIM_PORT=8080
